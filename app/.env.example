# Kopieren nach .env (wird vom Deploy-Workflow aus den GitHub-Secrets erzeugt)

# Öffentliche URL der App (für Links in Mails)
BASE_URL=https://app.locadas.de
APP_DOMAIN=app.locadas.de

# Zufällige lange Strings. Einmal setzen, nie ändern.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Claude (Erkennung der Felder im PDF, Angebots-Check). Ohne Key läuft die Heuristik.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Takt und Regeln
SCAN_INTERVAL_MINUTES=10
OFFER_FOLLOWUP_DAYS=3,7,14
INVOICE_FOLLOWUP_DAYS=3,10,20
DEFAULT_INVOICE_DUE_DAYS=14
APPROVALS_BEFORE_AUTO=5
INITIAL_SCAN_DAYS=30
SEND_HOUR_FROM=8
SEND_HOUR_TO=18
TZ=Europe/Berlin

# OAuth (später, für Gmail-Ein-Klick und Outlook/Microsoft 365)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

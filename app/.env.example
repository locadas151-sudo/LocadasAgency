# Kopieren nach .env (wird vom Deploy-Workflow aus den GitHub-Secrets erzeugt)

# Öffentliche URL der App (für Links in Mails)
BASE_URL=https://app.locadas.de
APP_DOMAIN=app.locadas.de
# Optional: eigene, neutrale Domain nur für den Dokument-Link in Kunden-Mails (/a/...), Standard wie BASE_URL
# VIEW_BASE_URL=https://dokument.example.de

# Zufällige lange Strings. Einmal setzen, nie ändern. Ohne beide startet die App nicht
# (nur für lokale Entwicklung: ALLOW_INSECURE_DEV=1, erlaubt auch lokale Mailserver ohne TLS).
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Claude (Erkennung der Felder im PDF, Angebots-Check). Ohne Key läuft die Heuristik.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Günstiges Modell für PDF-Erkennung und Zuordnung von Kundenmails
CLAUDE_FAST_MODEL=claude-haiku-5-5

# Takt und Regeln
SCAN_INTERVAL_MINUTES=10
OFFER_FOLLOWUP_DAYS=3,7,14
INVOICE_FOLLOWUP_DAYS=3,10,20
DEFAULT_INVOICE_DUE_DAYS=14
# Angebote über diesem Bruttobetrag nur mit Freigabe (je Betrieb in den Einstellungen änderbar). Rechnungen immer mit „Noch offen?“
APPROVAL_THRESHOLD=10000
PREVIEW_HOURS=2
INITIAL_SCAN_DAYS=30
SEND_HOUR_FROM=8
SEND_HOUR_TO=18
TZ=Europe/Berlin

# OAuth (später, für Gmail-Ein-Klick und Outlook/Microsoft 365)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# WhatsApp-Sekretär (Meta WhatsApp Cloud API, siehe WHATSAPP.md). Leer = alles per Mail.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# WhatsApp-Nachfasser über die eigene Nummer des Betriebs (Stufe 2, Coexistence, siehe WHATSAPP_COEXISTENCE.md).
# Erst einschalten, wenn Meta Locadas als Tech Provider freigegeben hat. Leer/0 = aus.
WA_BUSINESS_ENABLED=0
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# META_GRAPH_VERSION=v26.0
# WHATSAPP_BUSINESS_PRICE_EUR=0.0456
# WHATSAPP_BUSINESS_PRICE_MARKETING_EUR=0.1131
# WA_BUSINESS_REQUIRES_PRO=1

# Admin-Cockpit /admin, Alarme und Tagesbericht (locadas/ops/). Ohne ADMIN_EMAILS gibt es kein Cockpit.
# Kommaliste: wer mit dieser Adresse angemeldet ist oder sich einen Magic-Link schickt (/admin/login), darf rein
ADMIN_EMAILS=
# Alarme (neue Anmeldung, Postfach gestört, Fehler im Hintergrund) und Tagesbericht um 19 Uhr per WhatsApp an diese Nummer
# (E.164 ohne +). Braucht den WhatsApp-Sekretär oben, sonst geht alles per Mail an ADMIN_EMAILS (SYSTEM_SMTP_* nötig)
ADMIN_WHATSAPP=
# ADMIN_NAME=Julius
# ADMIN_DIGEST_HOUR=19

# Nächtliche Sicherung 03:15 nach DATA_DIR/backups (14 Stück). Optional zusätzlich nach S3 (braucht boto3 im Image
# und AWS-Zugang über eine IAM-Rolle der Instanz oder AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
# BACKUP_ENABLED=1
# BACKUP_KEEP=14
BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=locadas/

# Scheduler: Postfächer parallel lesen, Zeitlimit je Postfach (Sekunden)
# SCAN_WORKERS=8
# SCAN_ACCOUNT_TIMEOUT=300

# STARTTLS am SMTP-Empfänger: eigenes Zertifikat (Pfade im Container), leer = selbst signiert in DATA_DIR/tls
# INBOUND_TLS=1
INBOUND_TLS_CERT=
INBOUND_TLS_KEY=
